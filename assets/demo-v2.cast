[6.952, "o", "\r\n"]
[6.952, "o", "$ bolo \"Multi-paragraph mode — pipelined synthesis, no gaps.\"\r\n"]
[10.441, "o", "\r\u001b[K▶ [1/5] Bolo is a local TTS for the terminal."]
[13.666, "o", "\r\u001b[K▶ [2/5] It uses Kokoro for the voice."]
[16.315, "o", "\r\u001b[K▶ [3/5] Each paragraph is synthesised in one call so the prosody flows"]
[19.269, "o", "\r\u001b[K▶ [3/5] naturally."]
[21.49, "o", "\r\u001b[K▶ [4/5] The subtitle stays pinned to the bottom of your terminal and rewrites"]
[24.763, "o", "\r\u001b[K▶ [4/5] itself per sentence."]
[26.557, "o", "\r\u001b[K▶ [5/5] It never wraps or scrolls."]
