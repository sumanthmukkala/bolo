[16.513, "o", "\r\u001b[K▶ [3/5] Each paragraph is synthesised in one call so the prosody flows"]
[19.53, "o", "\r\u001b[K▶ [3/5] naturally."]
[21.705, "o", "\r\u001b[K▶ [4/5] The subtitle stays pinned to the bottom of your terminal and rewrites"]
[24.937, "o", "\r\u001b[K▶ [4/5] itself per sentence."]
[26.762, "o", "\r\u001b[K▶ [5/5] It never wraps or scrolls."]
